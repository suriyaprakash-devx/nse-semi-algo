# ================================================================
# Upstox Semi-Algo NSE Stock Scanner Environment Configuration
# ================================================================

# Upstox Developer API Credentials
# Obtain from https://developer.upstox.com/
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8000/api/auth/callback

# PostgreSQL Database (Provided automatically by Render in production)
# For local development, defaults to sqlite:///./scanner.db if omitted
DATABASE_URL=sqlite:///./scanner.db

# Encryption & Security
# Optional 32-byte base64 Fernet key to encrypt Upstox access tokens at rest.
# Generate in python with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
SESSION_SECRET_KEY=dev-secret-change-in-production-1234567890

# CORS & Deployment
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Scanner Configuration
DELETE_RESULTS_AFTER_SCAN=false
SCAN_CONCURRENCY=8
INCLUDE_CURRENT_DAY_CANDLE=true
