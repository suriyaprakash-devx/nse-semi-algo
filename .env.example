# ==============================================================================
# NSE SEMI-ALGO STOCK SCANNER ENVIRONMENT CONFIGURATION
# (Strictly Brokerless via Yahoo Finance — Never places orders)
# ==============================================================================

# Database: Leave empty for local SQLite (data/nse_scanner.db) or provide PostgreSQL URL on Render
DATABASE_URL=
FRONTEND_URL=http://localhost:5173
DELETE_RESULTS_AFTER_SCAN=false

# Scanner Strategy Defaults
SCAN_INTERVAL_MINUTES=10
DEFAULT_TIMEFRAME=10m
DEFAULT_VOLUME_MULTIPLIER=1.5
DEFAULT_VOLUME_LOOKBACK=20
DEFAULT_RISK_REWARD=2.0
MAX_STOCKS=200
MAX_WORKERS=5

# Optional Telegram Analytical Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Security & App Environment
SECRET_KEY=change_this_to_a_secure_random_string_32_chars_or_more
ENVIRONMENT=development
